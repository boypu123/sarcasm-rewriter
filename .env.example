# SarcasmMaster 模型配置示例
# ---------------------------------------------------------------
# 用法：复制本文件为 .env，然后按需修改。
#
#       cp .env.example .env          # Linux / macOS
#       copy .env.example .env        # Windows
#
# 注意：这里填的必须是**你已经在 Ollama 里拉取过的**本地模型名，
#       可以用 `ollama list` 查看当前有哪些模型。
# ---------------------------------------------------------------

# 用于 RAG 向量化的嵌入模型
EMBEDDING_MODEL = "nomic-embed-text"

# Agent 的"大脑"：负责决策、调用工具、生成阴阳怪气文案
LLM_MODEL = "qwen3:8b"
